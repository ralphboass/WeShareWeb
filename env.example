# Copy to .env.local for local development, and set the same variables in Vercel.
#
# Firebase web app config for the WeShare project (weshare-4ffbb).
# Get these from Firebase console -> Project settings -> Your apps -> Web app -> SDK setup.
# The iOS values in GoogleService-Info.plist do NOT work here: a Web app needs its own apiKey/appId.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=weshare-4ffbb.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=weshare-4ffbb
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=weshare-4ffbb.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=276606156987
NEXT_PUBLIC_FIREBASE_APP_ID=

# Stripe publishable key (safe to expose in the browser).
# Use the pk_test_... key locally so you don't authorize real cards.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
